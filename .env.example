# ============================================================================
# THRESH — Production & Local Environment Variables (.env.example)
# Copy this file to `.env` for local development, or configure these keys in
# Vercel Project Settings -> Environment Variables.
# Tip: Run `npm run secrets:generate` locally to generate fresh cryptographic
# values for SESSION_SECRET, TOKEN_VAULT_KEY, and CRON_SECRET.
# ============================================================================

# 1. CRYPTOGRAPHIC SECURITY & CRON SECRETS (Required in Production / Vercel)
# Generate each with: `openssl rand -hex 32`
# SESSION_SECRET signs HttpOnly `thresh_session` cookies across serverless instances.
SESSION_SECRET=""
# TOKEN_VAULT_KEY encrypts stored OAuth & API tokens at rest via AES-256-GCM (32-byte hex or passphrase).
TOKEN_VAULT_KEY=""
# CRON_SECRET authorizes scheduled `/api/cron/hourly-sync` triggers (`Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET=""

# 2. MULTI-TENANT CLOUD POSTGRES DATABASE (Optional locally; Recommended on Vercel)
# Supports Neon, Supabase, or Vercel Postgres (`postgresql://user:pass@host/db?sslmode=require`).
# When set, THRESH automatically creates & uses encrypted multi-tenant vault and profile tables.
# When omitted, THRESH falls back to per-session AES-256-GCM encrypted `/tmp/thresh-vault-*.enc` files.
DATABASE_URL=""

# 3. GOOGLE GEMINI API KEY (Optional — powers Thresh AI Coach; Clean-Room filtered)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 4. GARMIN CONNECT PERSONAL API KEY (Optional in .env — can also be configured in Data Sources UI)
# Format: GCDC_<uuid>.<uuid>.<signature>.<userId>
GARMIN_PERSONAL_API_KEY=""

# 5. INTERVALS.ICU API CREDENTIALS (Optional in .env — can also be configured in Data Sources UI)
# Generate your Personal API Key at: https://intervals.icu/settings
INTERVALS_API_KEY=""
INTERVALS_ATHLETE_ID="0"

# 6. STRAVA OAUTH2 CREDENTIALS (Optional — Personal Route & PR Overlay; Clean-Room isolated from AI)
# Create a personal API application at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REFRESH_TOKEN=""

# 7. MAP TILE API KEYS (Optional — keyless CARTO / OpenStreetMap tiles work out of the box)
MAPBOX_ACCESS_TOKEN=""
VITE_MAPBOX_ACCESS_TOKEN=""
THUNDERFOREST_API_KEY=""

# 8. APPLICATION BASE URL (Optional on Vercel/Localhost)
APP_URL="http://localhost:3000"

# 9. RESEND EMAIL DELIVERY (Optional — powers Team Bulk Invite Emails, Parent CCs & 6-Digit Email OTP)
# Free tier (3,000 emails/mo) at: https://resend.com/api-keys
# When omitted, Thresh gracefully falls back to zero-cost Magic Join Links, native `sms:` tap-to-text, and QR Posters.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Thresh Teams <onboarding@resend.dev>"
