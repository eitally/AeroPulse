# ============================================================================
# AeroPulse — Environment Variables (.env.example)
# Copy this file to `.env` for local development, or configure these keys in
# your Vercel Project Settings -> Environment Variables (or AI Studio Secrets).
# ============================================================================

# 1. GOOGLE GEMINI API KEY (Required for AI Coach & Daily Workout Generator)
# Get a key at: https://aistudio.google.com/app/apikey
# Note: In Google AI Studio, this is automatically injected from Secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. INTERVALS.ICU API CREDENTIALS (Optional in .env — can also be entered in UI)
# Generate your Personal API Key at: https://intervals.icu/settings (scroll to Developer Settings)
# Tip: Use "0" for INTERVALS_ATHLETE_ID to automatically resolve the owner of the API key,
# or enter your specific athlete ID (e.g., "i123456").
# Make sure Garmin Connect (Activities + Wellness/HRV/Sleep) is linked inside Intervals.icu!
INTERVALS_API_KEY=""
INTERVALS_ATHLETE_ID="0"

# 3. STRAVA OAUTH2 CREDENTIALS (Optional in .env — can also be entered in UI)
# Create a personal API application at: https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to your deployment hostname (e.g., your-app.vercel.app or localhost)
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# Optional: Set STRAVA_REFRESH_TOKEN (with activity:read_all scope) so serverless cold starts on Vercel automatically refresh Strava OAuth tokens
STRAVA_REFRESH_TOKEN=""

# 4. MAPBOX / OPENSTREETMAP TILE API KEY (Optional — Keyless OpenStreetMap/CARTO tiles work out of the box)
# Provide a Mapbox public token (pk.eyJ1...) or Thunderforest/OpenCycleMap API key if using custom map tiles.
MAPBOX_ACCESS_TOKEN=""
VITE_MAPBOX_ACCESS_TOKEN=""
THUNDERFOREST_API_KEY=""

# 5. APPLICATION BASE URL (Optional on Vercel/Localhost; auto-injected in AI Studio)
# Used for constructing OAuth callback URLs behind reverse proxies if needed.
APP_URL="http://localhost:3000"
