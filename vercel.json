{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(api|auth)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, private" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/hourly-sync",
      "schedule": "0 12 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/demo",
      "destination": "/?sample=coach&utm_source=print&utm_medium=qr&utm_campaign=demo",
      "permanent": false
    },
    {
      "source": "/ad",
      "destination": "/for-athletic-directors?utm_source=print&utm_medium=qr&utm_campaign=ad_brief",
      "permanent": false
    },
    {
      "source": "/meet",
      "destination": "/?role=coach&utm_source=print&utm_medium=banner&utm_campaign=meet_day",
      "permanent": false
    },
    {
      "source": "/clinic",
      "destination": "/?role=coach&utm_source=event&utm_medium=qr&utm_campaign=clinic",
      "permanent": false
    },
    {
      "source": "/flyer",
      "destination": "/?role=coach&utm_source=print&utm_medium=flyer&utm_campaign=pilot_2026",
      "permanent": false
    },
    {
      "source": "/sticker",
      "destination": "/?utm_source=merch&utm_medium=sticker&utm_campaign=varsity_crest",
      "permanent": false
    },
    {
      "source": "/go/clipboard",
      "destination": "/docs/coach.html?utm_source=print&utm_medium=clipboard_qr&utm_campaign=pod_sheet",
      "permanent": false
    },
    {
      "source": "/share",
      "destination": "/?role=coach&utm_source=share&utm_medium=card&utm_campaign=share_card",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/",
      "destination": "/docs/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/legal/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/legal/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/legal/terms.html"
    },
    {
      "source": "/terms/",
      "destination": "/legal/terms.html"
    },
    {
      "source": "/subprocessors",
      "destination": "/legal/subprocessors.html"
    },
    {
      "source": "/subprocessors/",
      "destination": "/legal/subprocessors.html"
    },
    {
      "source": "/procurement",
      "destination": "/legal/procurement.html"
    },
    {
      "source": "/procurement/",
      "destination": "/legal/procurement.html"
    },
    {
      "source": "/for-athletic-directors",
      "destination": "/for-athletic-directors.html"
    },
    {
      "source": "/for-athletic-directors/",
      "destination": "/for-athletic-directors.html"
    },
    {
      "source": "/((?!api/|auth/|assets/|docs(?:/|$)|legal(?:/|$)|privacy(?:/|$)|terms(?:/|$)|subprocessors(?:/|$)|procurement(?:/|$)|for-athletic-directors(?:/|$)|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
