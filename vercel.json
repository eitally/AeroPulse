{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/hourly-sync",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|auth/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
