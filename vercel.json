{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/hourly-sync",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|auth/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
