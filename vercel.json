{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https: https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com https://server.arcgisonline.com https://api.mapbox.com https://tile.thunderforest.com https://*.googleusercontent.com https://*.strava.com https://*.cloudfront.net; connect-src 'self' https:; worker-src 'self' blob:; media-src 'self' data: blob:; manifest-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(api|auth)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, private" }
      ]
    },
    {
      "source": "/(sw|registerSW).js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/hourly-sync",
      "schedule": "0 12 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/demo",
      "destination": "/?demo=1&sample=coach&utm_source=print&utm_medium=qr&utm_campaign=demo#coach",
      "permanent": false
    },
    {
      "source": "/ad",
      "destination": "/for-athletic-directors?utm_source=print&utm_medium=ad_packet&utm_campaign=school_po",
      "permanent": false
    },
    {
      "source": "/meet",
      "destination": "/?demo=1&sample=coach&utm_source=print&utm_medium=banner&utm_campaign=meet_day#coach",
      "permanent": false
    },
    {
      "source": "/clinic",
      "destination": "/?demo=1&sample=coach&utm_source=event&utm_medium=qr&utm_campaign=clinic#coach",
      "permanent": false
    },
    {
      "source": "/flyer",
      "destination": "/?demo=1&sample=coach&utm_source=print&utm_medium=flyer&utm_campaign=pilot_2026#coach",
      "permanent": false
    },
    {
      "source": "/sticker",
      "destination": "/?demo=1&sample=coach&utm_source=print&utm_medium=sticker&utm_campaign=varsity_crest#coach",
      "permanent": false
    },
    {
      "source": "/tee",
      "destination": "/?demo=1&sample=coach&utm_source=print&utm_medium=tee&utm_campaign=meet_day_tee#coach",
      "permanent": false
    },
    {
      "source": "/go/clipboard",
      "destination": "/?demo=1&sample=coach&utm_source=print&utm_medium=clipboard_qr&utm_campaign=pod_sheet#coach",
      "permanent": false
    },
    {
      "source": "/share",
      "destination": "/share/workout?preset=8x400&utm_source=share&utm_medium=card&utm_campaign=share_card",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/team/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/team/:slug/",
      "destination": "/api/index"
    },
    {
      "source": "/join/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/join/:slug/",
      "destination": "/api/index"
    },
    {
      "source": "/share/workout",
      "destination": "/api/index"
    },
    {
      "source": "/share/workout/",
      "destination": "/api/index"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/",
      "destination": "/docs/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/legal/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/legal/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/legal/terms.html"
    },
    {
      "source": "/terms/",
      "destination": "/legal/terms.html"
    },
    {
      "source": "/subprocessors",
      "destination": "/legal/subprocessors.html"
    },
    {
      "source": "/subprocessors/",
      "destination": "/legal/subprocessors.html"
    },
    {
      "source": "/procurement",
      "destination": "/legal/procurement.html"
    },
    {
      "source": "/procurement/",
      "destination": "/legal/procurement.html"
    },
    {
      "source": "/for-athletic-directors",
      "destination": "/for-athletic-directors.html"
    },
    {
      "source": "/for-athletic-directors/",
      "destination": "/for-athletic-directors.html"
    },
    {
      "source": "/time/:passCode",
      "destination": "/index.html"
    },
    {
      "source": "/time/:passCode/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|auth/|assets/|docs(?:/|$)|legal(?:/|$)|privacy(?:/|$)|terms(?:/|$)|subprocessors(?:/|$)|procurement(?:/|$)|for-athletic-directors(?:/|$)|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
